# GENERAL
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=https://app.meetnotes.localhost
COOKIE_DOMAIN=meetnotes.localhost
EMAIL_ADAPTER=mailhog

# DATABASE
DATABASE_URL=postgres://postgres:meeting_notes@localhost:5432/meeting_notes
DATABASE_TEST_URL=postgres://postgres:meeting_notes@localhost:5432/meeting_notes_test
REDIS_URL=redis://localhost:6379
BULLBOARD_PASSWORD=admin123

# MAILS
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# OBJECT STORAGE (RustFS from docker-compose; any S3-compatible bucket works)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
S3_ENDPOINT=http://127.0.0.1:9000
# Endpoint embedded in signed playback URLs handed to the browser (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
FILE_STORAGE_ADAPTER=s3
AWS_BUCKET_NAME=meeting-notes-media
# Max recording size accepted by the upload endpoint
MAX_UPLOAD_MB=500

# AI PIPELINE
# Transcription: openai (Whisper API, <=25 MB/file) | local (openai-whisper CLI on this host) | mock
TRANSCRIPTION_ADAPTER=mock
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
LOCAL_WHISPER_BINARY=whisper
LOCAL_WHISPER_MODEL=base
# Diarization: heuristic (no deps) | claude (text-based, uses Anthropic) | pyannote (HTTP service, see README)
DIARIZATION_ADAPTER=heuristic
DIARIZATION_SERVICE_URL=
# Summary, action items and decisions: claude | mock
SUMMARY_ADAPTER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# AUTH
BETTER_AUTH_SECRET=secret99secret99secret99secret99secret99
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=1111111111111-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example123
